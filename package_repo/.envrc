# direnv configuration — sets UV_PROJECT_ENVIRONMENT only where the repo's own .venv is not a good place.
# With conda: use the conda environment, so conda and uv packages coexist.
# On a network mount (e.g. ~/cloudfiles): a venv there is very slow, use a local disk path instead.
# On local disk without conda: nothing is set, uv uses .venv in the repo (same rule as `task setup_repo`).
# So it is safe to `direnv allow` this file on any disk.

CONDA_ENV_PATH="/anaconda/envs/{{ package_name }}"
LOCAL_ENV_PATH="${HOME}/.local/share/uv/envs/{{ package_name }}"

if [ -d "$CONDA_ENV_PATH" ]; then
    export UV_PROJECT_ENVIRONMENT="$CONDA_ENV_PATH"
else
    case "$(findmnt -T "$PWD" -no FSTYPE 2>/dev/null)" in
        cifs|smb*|nfs*|fuse*)
            mkdir -p "$LOCAL_ENV_PATH"
            export UV_PROJECT_ENVIRONMENT="$LOCAL_ENV_PATH"
            ;;
    esac
fi
